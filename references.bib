  author = {Th{\"o}ny, S. Schwyn and B{\"a}rtschi, M. and Batzer, M. and Baselgia, M. and Gm{\"u}nder, R. and Sharma, A. and Vermeij, T. and Maeder, X. and Waldner, S.},
  year = {2024},
  month = jun,
  volume = {13020},
  pages = {34--41},
  publisher = {SPIE},
  doi = {10.1117/12.3016637},
  urldate = {2025-04-14},
  abstract = {The concept of quantum nanolaminates (QNL) postulates the decoupling of band gap and refractive index, which in regular dielectric materials is linked. We will show that the quantization effect can be observed in nanolaminate structures of the material combinations Ta\textsubscript{2}O\textsubscript{5}-SiO\textsubscript{2} and amorphous silicon-SiO\textsubscript{2}, which were deposited by magnetron sputter deposition. These nanolaminates were characterized by a variety of different methods, which confirmed the layer structure in the nanometer range and the shift of the absorption edge to shorter wavelength. Furthermore, the use of the QNL as the high refractive index material in optical interference coatings was successfully demonstrated in anti-reflection and long pass filter coatings.}
