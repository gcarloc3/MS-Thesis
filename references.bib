@article{vergaraEffectRapidThermal2006,
  title = {Effect of Rapid Thermal Annealing on the Crystal Quality and the Piezoelectric Response of Polycrystalline {{AlN}} Films},
  author = {Vergara, L. and Olivares, J. and Iborra, E. and Clement, M. and {Sanz-Herv{\'a}s}, A. and Sangrador, J.},
