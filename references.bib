  doi = {10.1016/S1079-4050(99)80005-2},
  urldate = {2023-03-22},
  abstract = {This chapter discusses physics of sputtering. Thin-film, vacuum-based deposition technologies fall into two basic categories: (1) physical vapor deposition (PVD) and (2) chemical vapor deposition (CVD). PVD techniques include physical sputtering, thermal evaporation, and arc-based deposition. These techniques are atomic in nature. The films are deposited from single atoms or small clusters and any reactions that occur (such as oxidation or nitridization) occur at the film surface, independently of the source process. Sputtering is a simple process in which an energetic particle bombards a target surface with sufficient energy to result in the ejection of one or more atoms from the target. The aspects of sputtering that may lead to significant effects on film deposition are reflected, energetic neutrals, and negative ions. Sputtered atoms typically travel some distance before they can impact a sample surface to form a deposited film. A process developed at a low sputtering and deposition rate at a moderate pressure may be completely different as the deposition rate is scaled up and the effective gas density is reduced.},
  langid = {english},
  file = {C\:\\Users\\User\\Zotero\\storage\\89BTFKZ7\\Powell and Rossnagel - 1999 - Chapter 2 Physics of sputtering.pdf;C\:\\Users\\User\\Zotero\\storage\\SBQDFP62\\S1079405099800052.html}
}

@article{riturajHighlySensitiveEfficient2025,
