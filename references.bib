  publisher = {Elsevier},
  address = {Oxford},
  doi = {10.1016/B978-008044164-1/50011-6},
  urldate = {2023-03-22},
  abstract = {Recovery is a relatively homogeneous process in terms of both space and time. When viewed on a scale larger than the cell or subgrain size, most areas of a sample are changing in a similar way. Recovery progresses gradually with time and there is no readily identifiable beginning or end of the process. In contrast, recrystallization involves the formation of new strain-free grains in certain parts of the specimen and the subsequent growth of these to consume the deformed or recovered microstructure. The microstructure is divided into recrystallized or non-recrystallized, and the fraction recrystallized increases from 0 to 1 as the transformation proceeds. This is typical of a discontinuous annealing phenomenon. Recrystallization of the deformed microstructure is often called primary recrystallization in order to distinguish it from the process of abnormal grain growth that may occur in fully recrystallized material and is sometimes called secondary recrystallization. This chapter discusses the origin of recrystallization, and general aspects such as the kinetics and other factors that affect both the process of recrystallization and the final microstructure.},
  isbn = {978-0-08-044164-1},
  langid = {english},
  file = {C\:\\Users\\User\\Zotero\\storage\\9SN9S5XY\\Humphreys and Hatherly - 2004 - Chapter 7 - Recrystallization of Single-Phase Allo.pdf;C\:\\Users\\User\\Zotero\\storage\\DIJXC6R8\\B9780080441641500116.html}
}

