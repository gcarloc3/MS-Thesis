  volume = {431},
  pages = {152--159},
  issn = {0169-4332},
  doi = {10.1016/j.apsusc.2017.09.036},
  urldate = {2023-03-22},
  abstract = {A highly oriented AlN layer has been successfully grown along the c-axis on a polycrystalline chemical vapor deposited (CVD) diamond by RF reactive magnetron sputtering. Structural, morphological and mechanical properties of the heterostructure were investigated by Scanning Electron Microscopy (SEM), Atomic Force Microscopy (AFM), Transmission Electron Microscopy (TEM), X-ray diffraction (XRD), Nano-indentation and Four-probe meter. A compact AlN film was demonstrated on the diamond layer, showing columnar grains and a low surface roughness of 1.4nm. TEM results revealed a sharp AlN/diamond interface, which was characterized by the presence of a distinct 10nm thick buffer layer resulting from the initial AlN growth stage. The FWHM of AlN (002) diffraction peak and its rocking curve are as low as 0.41{$^\circ$} and 3.35{$^\circ$} respectively, indicating a highly preferred orientation along the c-axis. AlN sputtered films deposited on glass substrates show a higher bulk resistivity (up to 3{\texttimes}1012{\textohm}cm), compared to AlN films deposited on diamond ({$\sim$}1010{\textohm}cm). Finally, the film hardness and Young's modulus of AlN films on diamond are 25.8GPa and 489.5GPa, respectively.},
  langid = {english},
  keywords = {AlN films,Buffer layer,Bulk resistivity,Hardness and Young's modulus,Rocking curve},
