  keywords = {Absorption coefficient,Hybrid lasers,Laser sources,Scanning electron microscopy,Semiconductor lasers,Total internal reflection},
  file = {C:\Users\User\Zotero\storage\ELBXMDP4\Jung et al. - 2017 - Terahertz difference-frequency quantum cascade laser sources on silicon.pdf}
}

