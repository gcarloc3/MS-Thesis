@article{moisonSurfaceSegregationIII1991,
  title = {Surface Segregation in {{III}}--{{V}} Alloys},
  author = {Moison, J. M. and Houzay, F. and Barthe, F. and G{\'e}rard, J. M. and Jusserand, B. and Massies, J. and {Turco-Sandroff}, F. S.},
  year = {1991},
