@article{vashisthaComprehensiveStudyUltrafast2021,
  title = {A Comprehensive Study of Ultrafast Carrier Dynamics of {{LT-GaAs}}: {{Above}} and below Bandgap Regions},
  shorttitle = {A Comprehensive Study of Ultrafast Carrier Dynamics of {{LT-GaAs}}},
  author = {Vashistha, Nikita and Kumar, Mahesh and Singh, Rajiv K. and Panda, Debiprasad and Tyagi, Lavi and Chakrabarti, Subhananda},
  year = {2021},
