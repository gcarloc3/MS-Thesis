@article{chengPreparation002Oriented2003,
  title = {Preparation of [002] Oriented {{AlN}} Thin Films by Mid Frequency Reactive Sputtering Technique},
  author = {Cheng, Hsyi-En and Lin, Tien-Chai and Chen, Wen-Chien},
