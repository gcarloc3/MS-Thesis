  author = {Leo, Gibson and Longo, Massimo and Lovergine, Nico and Mancini, A.M. and Vasanelli, L. and Drigo, {\relax AV} and Romanato, Filippo and Peluso, T. and Tapfer, Leander},
  year = {1996},
