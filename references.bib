}

@article{lloyd-hughesSimulationOptimisationTerahertz2005,
  title = {Simulation and Optimisation of Terahertz Emission from {{InGaAs}} and {{InP}} Photoconductive Switches},
  author = {{Lloyd-Hughes}, J. and {Castro-Camus}, E. and Johnston, M. B.},
  year = {2005},
  month = dec,
  journal = {Solid State Communications},
  volume = {136},
  number = {11},
  pages = {595--600},
  issn = {0038-1098},
  doi = {10.1016/j.ssc.2005.09.037},
  urldate = {2025-04-07},
  abstract = {We simulate the terahertz emission from laterally biased InGaAs and InP using a three-dimensional carrier dynamics model in order to optimise the semiconductor material. Incident pump-pulse parameters of current Ti:Sapphire and Er:fibre lasers are chosen, and the simulation models the semiconductor's bandstructure using parabolic {$\Gamma$}, L and X valleys, and heavy holes. The emitted terahertz radiation is propagated within the semiconductor and into free space using a model based on the Drude--Lorentz dielectric function. As the InGaAs alloy approaches InAs an increase in the emitted power is observed, and this is attributed to a greater electron mobility. Additionally, low-temperature grown and ion-implanted InGaAs are modelled using a finite carrier trapping time. At sub-picosecond trapping times the terahertz bandwidth is found to increase significantly at the cost of a reduced emission power.},
  keywords = {A. InGaAs,A. InP,D. Photoconductive switch,D. Ultrafast photonics,E. Terahertz radiation},
  file = {C\:\\Users\\User\\Zotero\\storage\\GT6SEIE3\\Lloyd-Hughes et al. - 2005 - Simulation and optimisation of terahertz emission from InGaAs and InP photoconductive switches.pdf;C\:\\Users\\User\\Zotero\\storage\\2DBSRL7T\\S0038109805008148.html}
}

@article{luUltrasonicFingerprintSensor2015,
  title = {Ultrasonic Fingerprint Sensor Using a Piezoelectric Micromachined Ultrasonic Transducer Array Integrated with Complementary Metal Oxide Semiconductor Electronics},
  author = {Lu, Y. and Tang, H. and Fung, S. and Wang, Q. and Tsai, J. M. and Daneman, M. and Boser, B. E. and Horsley, D. A.},
  year = {2015},
  month = jun,
  journal = {Applied Physics Letters},
  volume = {106},
  number = {26},
  pages = {263503},
  issn = {0003-6951},
  doi = {10.1063/1.4922915},
  urldate = {2023-05-14},
  abstract = {This paper presents an ultrasonic fingerprint sensor based on a 24\,{\texttimes}\,8 array of 22\,MHz piezoelectric micromachined ultrasonic transducers (PMUTs) with 100\,{$\mu$}m pitch, fully integrated with 180\,nm complementary metal oxide semiconductor (CMOS) circuitry through eutectic wafer bonding. Each PMUT is directly bonded to a dedicated CMOS receive amplifier, minimizing electrical parasitics and eliminating the need for through-silicon vias. The array frequency response and vibration mode-shape were characterized using laser Doppler vibrometry and verified via finite element method simulation. The array's acoustic output was measured using a hydrophone to be {$\sim$}14\,kPa with a 28\,V input, in reasonable agreement with predication from analytical calculation. Pulse-echo imaging of a 1D steel grating is demonstrated using electronic scanning of a 20\,{\texttimes}\,8 sub-array, resulting in 300\,mV maximum received amplitude and 5:1 contrast ratio. Because the small size of this array limits the maximum image size, mechanical scanning was used to image a 2D polydimethylsiloxane fingerprint phantom (10\,mm {\texttimes} 8\,mm) at a 1.2\,mm distance from the array.},
  file = {C\:\\Users\\User\\Zotero\\storage\\FMVEYCZL\\Lu et al. - 2015 - Ultrasonic fingerprint sensor using a piezoelectri.pdf;C\:\\Users\\User\\Zotero\\storage\\QTIJRC6E\\Ultrasonic-fingerprint-sensor-using-a.html}
}

@article{mahalingamSubstrateTemperatureDependence1991,
  title = {Substrate Temperature Dependence of Arsenic Precipitate Formation in {{AlGaAs}} and {{GaAs}}},
  author = {Mahalingam, K. and Otsuka, N. and Melloch, M. R. and Woodall, J. M. and Warren, A. C.},
  year = {1991},
  month = jul,
  journal = {Journal of Vacuum Science \& Technology B: Microelectronics and Nanometer Structures Processing, Measurement, and Phenomena},
  volume = {9},
  number = {4},
  pages = {2328--2332},
  issn = {1071-1023},
  doi = {10.1116/1.585742},
  urldate = {2025-04-04},
  abstract = {GaAs epilayers which are grown by molecular-beam epitaxy under ``normal'' group III--V fluxes but at very low substrate temperatures contain as much as 1\% excess arsenic. Upon annealing these epilayers at a temperature of 600\,{$^\circ$}C, the excess arsenic forms precipitates. We have undertaken a systematic study of the substrate growth temperature dependence of this incorporation of excess arsenic in both GaAs and Al0.3Ga0.7As epilayers. The substrate growth temperature was varied in increments of 25\,{$^\circ$}C from 225 to 375\,{$^\circ$}C after every 0.25 {$\mu$}m of film growth for a GaAs and an Al0.3Ga0.7As epilayer. Both epilayers were grown using a dimer arsenic source and a group V to total group III beam equivalent pressure {$\sim$}20. After growth the films were annealed for 1 h in the As2 flux at a temperature of 600\,{$^\circ$}C. Cross-sectional samples were than prepared by the ion thinning technique and examined by transmission electron microscopy (TEM). Both epilayers contained arsenic precipitates; this is the first observation of arsenic precipitates in an Al0.3Ga0.7As epilayer. The density of the arsenic precipitates in the two epilayers had a strong dependence on substrate growth temperature. Details of the film growth and of the TEM observations are reported.},
  file = {C:\Users\User\Zotero\storage\ZSUXU7LQ\Substrate-temperature-dependence-of-arsenic.html}
}

